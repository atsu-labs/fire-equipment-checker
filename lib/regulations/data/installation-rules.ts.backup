/**
 * 設備種別でルールをフィルタ
 */
export function getRulesByEquipmentType(
  equipmentType: string
): InstallationRule[] {
  return INSTALLATION_RULES.filter(rule => rule.equipmentType === equipmentType);
}

/**
 * ルールIDでルールを取得
 */
export function getRuleById(id: string): InstallationRule | undefined {
  return INSTALLATION_RULES.find(rule => rule.id === id);
}

/**
 * 優先度順にソートされたルール一覧
 */
export const SORTED_RULES = [...INSTALLATION_RULES].sort(
  (a, b) => b.priority - a.priority
);
